# Скопируй в .env.setup и заполни. Этот файл нужен только для `npm run setup`,
# в приложение он не попадает. Никому не отправляй — тут секретный ключ.

# Appwrite → Settings проекта → API endpoint и Project ID
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-project-id

# Appwrite → Overview → Integrations → API keys → Create API key (права перечислены в README)
APPWRITE_API_KEY=your-secret-api-key

# LiveKit Cloud → Settings → Keys (можно оставить пустыми и добавить позже)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
